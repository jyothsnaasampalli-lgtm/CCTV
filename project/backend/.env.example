# CCTV Sense - Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
DEBUG=True

# SQLite Database Location
DATABASE_PATH=database/cctv_sense.db

# Machine Learning Model Artifact Location
MODEL_PATH=ml/cctv_sense_model.pkl

# Notification & Alert Integrations (Optional Webhook / Email / Slack / SMS)
ALERT_WEBHOOK_URL=https://webhook.site/example-alert-receiver
NOTIFICATION_ENABLED=True
MIN_ALERT_SEVERITY=MEDIUM

# Security Staff Contact
SECURITY_DESK_EMAIL=security@healthnova.campus.edu
